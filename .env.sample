# Copy to .env and fill in real values. .env is gitignored.
# Sourced by scripts/smoke-test.sh.

# Credentials for the authenticated portion of the smoke test.
# Leave blank to run public-endpoint checks only.
SMOKE_EMAIL=system@memoryvault.local
SMOKE_PASSWORD=

# Encryption key for backup provider credentials (AES-256-GCM).
# Generate with: openssl rand -hex 16
MEMORYVAULT_ENCRYPTION_KEY=

# `terraform.tfvars` is in .gitignore if it needs to be recreated, the values from SSM will have to be retrieved. Use the
#  following command for the retrieval: aws ssm get-parameter --name /memoryvault/encryption-key --with-decryption --query Parameter.Value --output text

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_...
STRIPE_BACKUP_MONTHLY_PRICE_ID=price_...
STRIPE_BACKUP_ANNUAL_PRICE_ID=price_...
